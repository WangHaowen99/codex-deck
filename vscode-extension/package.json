{
  "name": "codex-deck",
  "displayName": "Codex Deck",
  "description": "Manage Codex Deck sessions from the VS Code sidebar.",
  "version": "0.1.13",
  "publisher": "codex-deck",
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:codexDeck.sessions",
    "onCommand:codexDeck.refresh",
    "onCommand:codexDeck.newSession",
    "onCommand:codexDeck.openSession",
    "onCommand:codexDeck.closeSession",
    "onCommand:codexDeck.openHistorySession",
    "onCommand:codexDeck.deleteSession",
    "onCommand:codexDeck.renameSession",
    "onCommand:codexDeck.copyUuid",
    "onCommand:codexDeck.showFailureDetails",
    "onCommand:codexDeck.showToolDetails",
    "onCommand:codexDeck.showCompactionDetails"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Codex Deck",
      "properties": {
        "codexDeck.cdxPath": {
          "type": "string",
          "default": "cdx",
          "description": "Path to the cdx executable on the remote/workspace host."
        },
        "codexDeck.defaultCwd": {
          "type": "string",
          "default": "",
          "description": "Default working directory for new Codex Deck sessions. Empty uses the first workspace folder or the remote home directory."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexDeck",
          "title": "Codex Deck",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codexDeck": [
        {
          "id": "codexDeck.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "codexDeck.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "codexDeck.newSession",
        "title": "New Session",
        "icon": "$(add)"
      },
      {
        "command": "codexDeck.openSession",
        "title": "Open Session",
        "icon": "$(terminal)"
      },
      {
        "command": "codexDeck.renameSession",
        "title": "Rename Session",
        "icon": "$(edit)"
      },
      {
        "command": "codexDeck.closeSession",
        "title": "Close Session",
        "icon": "$(close)"
      },
      {
        "command": "codexDeck.openHistorySession",
        "title": "Open History Session",
        "icon": "$(history)"
      },
      {
        "command": "codexDeck.deleteSession",
        "title": "Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "codexDeck.copyUuid",
        "title": "Copy Codex UUID",
        "icon": "$(copy)"
      },
      {
        "command": "codexDeck.showFailureDetails",
        "title": "查看调用失败原因",
        "icon": "$(warning)"
      },
      {
        "command": "codexDeck.showToolDetails",
        "title": "查看工具调用详情",
        "icon": "$(tools)"
      },
      {
        "command": "codexDeck.showCompactionDetails",
        "title": "查看压缩详情",
        "icon": "$(archive)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexDeck.newSession",
          "when": "view == codexDeck.sessions",
          "group": "navigation@1"
        },
        {
          "command": "codexDeck.refresh",
          "when": "view == codexDeck.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "codexDeck.openHistorySession",
          "when": "view == codexDeck.sessions && !viewItem",
          "group": "navigation@1"
        },
        {
          "command": "codexDeck.openSession",
          "when": "view == codexDeck.sessions && viewItem == cdxSession",
          "group": "inline@1"
        },
        {
          "command": "codexDeck.renameSession",
          "when": "view == codexDeck.sessions && viewItem == cdxSession",
          "group": "navigation@1"
        },
        {
          "command": "codexDeck.copyUuid",
          "when": "view == codexDeck.sessions && viewItem == cdxSession",
          "group": "navigation@2"
        },
        {
          "command": "codexDeck.showFailureDetails",
          "when": "view == codexDeck.sessions && viewItem == cdxSession",
          "group": "navigation@3"
        },
        {
          "command": "codexDeck.showToolDetails",
          "when": "view == codexDeck.sessions && viewItem == cdxSession",
          "group": "navigation@4"
        },
        {
          "command": "codexDeck.showCompactionDetails",
          "when": "view == codexDeck.sessions && viewItem == cdxSession",
          "group": "navigation@5"
        },
        {
          "command": "codexDeck.closeSession",
          "when": "view == codexDeck.sessions && viewItem == cdxSession",
          "group": "navigation@8"
        },
        {
          "command": "codexDeck.deleteSession",
          "when": "view == codexDeck.sessions && viewItem == cdxSession",
          "group": "navigation@9"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.86.0",
    "typescript": "^5.3.3"
  }
}
