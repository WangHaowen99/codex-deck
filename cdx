def load_codex_sessions() -> list[RawCodexSession]:
    sessions: dict[str, RawCodexSession] = {}
    if CODEX_SESSION_INDEX.exists():
        with CODEX_SESSION_INDEX.open("r", encoding="utf-8") as f:
            for line in f:
                try:
                    item = json.loads(line)
                except json.JSONDecodeError:
                    continue
                sid = item.get("id")
                if not sid:
                    continue
                sessions[sid] = RawCodexSession(
                    id=sid,
                    title=item.get("thread_name") or "(untitled)",
                    updated_at=item.get("updated_at"),
                )

    if CODEX_SESSIONS_DIR.exists():
        for path in CODEX_SESSIONS_DIR.glob("**/*.jsonl"):
            sid = None
            title = None
            cwd = None
            timestamp = None
            try:
                stat_time = datetime.fromtimestamp(path.stat().st_mtime, timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
            except OSError:
                stat_time = None
            try:
                with path.open("r", encoding="utf-8") as f:
                    for idx, line in enumerate(f):
                        if idx > 250 and sid:
                            break
                        try:
                            item = json.loads(line)
                        except json.JSONDecodeError:
                            continue
                        payload = item.get("payload", {})
                        if item.get("type") == "session_meta":
                            sid = payload.get("id") or sid
                            cwd = payload.get("cwd") or cwd
                            timestamp = payload.get("timestamp") or item.get("timestamp") or timestamp
                        if not title and item.get("type") in {"user_message", "turn_context"}:
                            title = str(payload)[:80]
            except OSError:
                continue
            if not sid:
                match = re.search(r"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", path.name)
                sid = match.group(1) if match else None
            if not sid:
                continue
            existing = sessions.get(sid)
            if existing:
                existing.cwd = existing.cwd or cwd
                existing.transcript_path = existing.transcript_path or str(path)
                existing.updated_at = existing.updated_at or timestamp or stat_time
                if existing.title == "(untitled)" and title:
                    existing.title = title
            else:
                sessions[sid] = RawCodexSession(
                    id=sid,
                    title=title or "(untitled)",
                    updated_at=timestamp or stat_time,
                    cwd=cwd,
                    transcript_path=str(path),
                )
    return sorted(sessions.values(), key=lambda s: sort_key_time(s.updated_at), reverse=True)


def choose_raw_codex_session(prompt: str = "选择 Codex 原始会话") -> RawCodexSession | None:
    raws = load_codex_sessions()
    if not raws:
        print_empty("没有找到 Codex 原始会话。")
        return None
    registry = load_registry()
    bound = {s.get("codex_session_id"): s.get("name") for s in registry.get("sessions", []) if s.get("codex_session_id")}
    print_header("Codex 原始会话", "按最近更新时间排序；bound 表示已被 cdx 管理。")
    for i, raw in enumerate(raws, start=1):
        marker = f"  {status_text('bound')}: {short_text(bound[raw.id], 18)}" if raw.id in bound else ""
        title = short_text(raw.title, 32)
        print(f"  {cyan(str(i).rjust(2))}  {bold(title)}")
        print(f"      {dim(raw.id[:8] + '...')}  {dim(display_time(raw.updated_at))}{marker}")
    print(rule())
    choice = globals()["prompt"](f"{prompt} [编号/UUID，空取消]: ")
    if not choice:
        return None
    if choice.isdigit():
        idx = int(choice)
        if 1 <= idx <= len(raws):
            return raws[idx - 1]
    for raw in raws:
        if raw.id == choice or raw.id.startswith(choice):
            return raw
    print(red("未找到 Codex 会话。"))
    return None


def map_bind(target_session_id: str | None = None, *, force_transfer: bool = False) -> int:
    if target_session_id:
        registry = load_registry()
        target = find_session_by_id(registry, target_session_id)
    else:
        target = choose_cdx_session("绑定到哪个 cdx 会话")
    if not target:
        return 1
    if tmux_exists(target["tmux_session"]):
        print(yellow("该 cdx 会话正在运行，MVP 不允许修改绑定。请先退出 Codex。"))
        return 1
    raw = choose_raw_codex_session()
    if not raw:
        return 1
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, target["id"])
        if not current:
            print(red("注册表中找不到目标会话。"))
            return 1
        holder = find_session_by_codex_id(registry, raw.id)
        if holder and holder.get("id") != current.get("id"):
            if tmux_exists(holder["tmux_session"]):
                print(yellow(f"该 Codex 会话已绑定到 live 会话：{holder['name']}，不能转移。"))
                return 1
            if not force_transfer:
                print(yellow(f"该 Codex 会话已绑定到：{holder['name']}"))
                if not ask_yes_no(f"是否转移绑定到：{current['name']}？", default=False):
                    return 1
            holder["codex_session_id"] = None
            holder["transcript_path"] = None
            holder["updated_at"] = now_utc()
        if current.get("codex_session_id") and current.get("codex_session_id") != raw.id:
            if not ask_yes_no("目标会话已有绑定，是否替换？", default=False):
                return 1
        current["codex_session_id"] = raw.id
        if raw.cwd:
            current["last_cwd"] = raw.cwd
        current["transcript_path"] = raw.transcript_path
        current["updated_at"] = now_utc()
        save_registry(registry, timestamped_backup=True)
    print(green("绑定完成。"))
    log_event(f"bound cdx id={target['id']} to codex id={raw.id}")
    return 0


def map_import() -> int:
    raw = choose_raw_codex_session("导入哪个 Codex 原始会话")
    if not raw:
        return 1
    registry = load_registry()
    holder = find_session_by_codex_id(registry, raw.id)
    if holder:
        print(yellow(f"该 Codex 会话已绑定到：{holder['name']}"))
        return 1
    name = prompt("新的 cdx_name: ")
    try:
        name = validate_name(name)
    except CdxError as exc:
        print(red(f"错误: {exc}"))
        return 1
    if find_session_by_name(registry, name):
        print(red("cdx_name 已存在。"))
        return 1
    cwd = raw.cwd if raw.cwd and Path(raw.cwd).is_dir() else None
    if not cwd:
        print(yellow("无法从 Codex 原始会话读取有效 cwd，请选择目录。"))
        cwd = choose_session_directory()
        if not cwd:
            return 1
    try:
        create_record(name, cwd, codex_session_id=raw.id, transcript_path=raw.transcript_path)
    except CdxError as exc:
        print(red(f"错误: {exc}"))
        return 1
    print(green("导入完成。"))
    return 0


def map_unbind() -> int:
    target = choose_cdx_session("解除哪个 cdx 会话的绑定")
    if not target:
        return 1
    if tmux_exists(target["tmux_session"]):
        print(yellow("该 cdx 会话正在运行，MVP 不允许解除绑定。请先退出 Codex。"))
        return 1
    if not target.get("codex_session_id"):
        print(dim("该会话没有绑定。"))
        return 0
    if not ask_yes_no(f"确认解除绑定：{target['name']}？", default=False):
        return 1
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, target["id"])
        if not current:
            return 1
        current["codex_session_id"] = None
        current["transcript_path"] = None
        current["updated_at"] = now_utc()
        save_registry(registry, timestamped_backup=True)
    print(green("已解除绑定。"))
    return 0


def cmd_map(args: list[str]) -> int:
    sub = args[0] if args else ""
    if sub == "bind":
        return map_bind()
    if sub == "import":
        return map_import()
    if sub in {"unbind", "clear"}:
        return map_unbind()
    if sub == "transfer":
        return map_bind(force_transfer=True)
    return map_menu()


