"""Codex Deck: manage Codex CLI sessions through tmux."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import unicodedata
from contextlib import contextmanager
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


APP_NAME = "Codex Deck"
APP_ID = "cdx"
VERSION = 1
MAX_NAME_LEN = 60
CDX_HOOK_STATUS = "cdx session mapping"
COLOR_ENABLED = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
ASCII_BANNER = [
    "  ____          _             ____            _    ",
    " / ___|___   __| | _____  __ |  _ \\  ___  ___| | __",
    "| |   / _ \\ / _` |/ _ \\ \\/ / | | | |/ _ \\/ __| |/ /",
    "| |__| (_) | (_| |  __/>  <  | |_| |  __/ (__|   < ",
    " \\____\\___/ \\__,_|\\___/_/\\_\\ |____/ \\___|\\___|_|\\_\\",
]

HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local" / "share"))
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state"))

CONFIG_DIR = CONFIG_HOME / APP_ID
DATA_DIR = DATA_HOME / APP_ID
STATE_DIR = STATE_HOME / APP_ID
CONFIG_PATH = CONFIG_DIR / "config.json"
REGISTRY_PATH = DATA_DIR / "sessions.json"
LOCK_PATH = STATE_DIR / "lock"
LOG_PATH = STATE_DIR / "cdx.log"

CODEX_HOME = Path(os.environ.get("CODEX_HOME", HOME / ".codex"))
CODEX_CONFIG_PATH = CODEX_HOME / "config.toml"
CODEX_HOOKS_PATH = CODEX_HOME / "hooks.json"
CODEX_SESSION_INDEX = CODEX_HOME / "session_index.jsonl"
CODEX_SESSIONS_DIR = CODEX_HOME / "sessions"


class CdxError(Exception):
    pass


@dataclass
class RawCodexSession:
    id: str
    title: str
    updated_at: str | None = None
    cwd: str | None = None
    transcript_path: str | None = None


def color(text: str, code: str) -> str:
    if not COLOR_ENABLED:
        return text
    return f"\033[{code}m{text}\033[0m"


def bold(text: str) -> str:
    return color(text, "1")


def dim(text: str) -> str:
    return color(text, "2")


def green(text: str) -> str:
    return color(text, "32")


def yellow(text: str) -> str:
    return color(text, "33")


def red(text: str) -> str:
    return color(text, "31")


def cyan(text: str) -> str:
    return color(text, "36")


def ui_width() -> int:
    columns = shutil.get_terminal_size((72, 20)).columns
    return max(44, min(columns, 104))


def rule() -> str:
    return dim("─" * ui_width())


def display_len(text: str) -> int:
    width = 0
    for ch in text:
        width += 2 if unicodedata.east_asian_width(ch) in {"F", "W"} else 1
    return width


def pad_display(text: str, width: int) -> str:
    return text + " " * max(0, width - display_len(text))


def print_banner() -> None:
    width = ui_width()
    if width < 58:
        print(cyan(bold("Codex Deck")))
        return
    for line in ASCII_BANNER:
        print(cyan(line.center(width)))


def print_header(title: str, subtitle: str | None = None, *, banner: bool = False) -> None:
    print()
    if banner:
        print_banner()
        print()
    print(bold(title))
    if subtitle:
        print(dim(subtitle))
    print(rule())


def print_empty(message: str) -> None:
    print(dim(f"  {message}"))


def prompt(message: str) -> str:
    return input(cyan("› ") + message).strip()


def status_text(value: str) -> str:
    if value == "live":
        return green("live")
    if value == "bound":
        return cyan("bound")
    if value in {"unbound", "warn"}:
        return yellow(value)
    if value in {"err", "error"}:
        return red(value)
    return dim(value)


def print_menu(title: str, items: list[tuple[str, str, str]], subtitle: str | None = None, *, banner: bool = False) -> None:
    print_header(title, subtitle, banner=banner)
    width = ui_width()
    desktop = width >= 78
    label_width = min(22, max((display_len(label) for _, label, _ in items), default=0))
    for key, label, desc in items:
        key_text = cyan(f"{key:>2}")
        if desktop:
            label_text = bold(pad_display(label, label_width))
            desc_text = dim(desc)
            print(f"  {key_text}  {label_text}      {desc_text}")
        else:
            label_text = bold(label)
            print(f"  {key_text}  {label_text}")
            if desc:
                print(f"      {dim(desc)}")
            print()
    print(rule())


def ensure_dirs() -> None:
    for path in (CONFIG_DIR, DATA_DIR, STATE_DIR):
        path.mkdir(parents=True, exist_ok=True)


def now_utc() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def backup_suffix() -> str:
    return datetime.now().strftime("%Y%m%d-%H%M%S")


def log_event(message: str) -> None:
    try:
        ensure_dirs()
        with LOG_PATH.open("a", encoding="utf-8") as f:
            f.write(f"{now_utc()} {message}\n")
    except OSError:
        pass


@contextmanager
def registry_lock():
    ensure_dirs()
    with LOCK_PATH.open("a+", encoding="utf-8") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def load_json(path: Path, default: dict[str, Any]) -> dict[str, Any]:
    if not path.exists():
        return default
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def write_json_atomic(path: Path, data: dict[str, Any], *, backup: bool = False, timestamped: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists() and backup:
        shutil.copy2(path, path.with_suffix(path.suffix + ".bak"))
        if timestamped:
            shutil.copy2(path, path.with_suffix(path.suffix + f".bak.{backup_suffix()}"))
    tmp = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    with tmp.open("w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def default_config() -> dict[str, Any]:
    return {
        "version": VERSION,
        "roots": [
            {
                "id": "home",
                "name": "home",
                "path": str(HOME),
            }
        ],
    }


def default_registry() -> dict[str, Any]:
    return {"version": VERSION, "sessions": []}


def load_config() -> dict[str, Any]:
    data = load_json(CONFIG_PATH, default_config())
    if data.get("version") != VERSION:
        raise CdxError(f"不支持的配置版本: {data.get('version')}")
    data.setdefault("roots", [])
    return data


def save_config(config: dict[str, Any]) -> None:
    config["version"] = VERSION
    write_json_atomic(CONFIG_PATH, config, backup=CONFIG_PATH.exists())


def load_registry() -> dict[str, Any]:
    data = load_json(REGISTRY_PATH, default_registry())
    if data.get("version") != VERSION:
        raise CdxError(f"不支持的注册表版本: {data.get('version')}")
    data.setdefault("sessions", [])
    return data


def save_registry(registry: dict[str, Any], *, timestamped_backup: bool = False) -> None:
    registry["version"] = VERSION
    write_json_atomic(REGISTRY_PATH, registry, backup=REGISTRY_PATH.exists(), timestamped=timestamped_backup)


def parse_iso(value: str | None) -> datetime | None:
    if not value:
        return None
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    match = re.match(r"^(.*T\d\d:\d\d:\d\d)\.(\d+)([+-]\d\d:\d\d)$", text)
    if match:
        text = f"{match.group(1)}.{match.group(2)[:6]:<06}{match.group(3)}"
    try:
        return datetime.fromisoformat(text)
    except ValueError:
        return None


def display_time(value: str | None) -> str:
    dt = parse_iso(value)
    if not dt:
        return "--"
    return dt.astimezone().strftime("%m-%d %H:%M")


def sort_key_time(value: str | None) -> float:
    dt = parse_iso(value)
    return dt.timestamp() if dt else 0.0


def require_tool(name: str) -> None:
    if shutil.which(name) is None:
        raise CdxError(f"未找到 {name}，请先安装。")


def validate_name(raw: str) -> str:
    name = raw.strip()
    if not name:
        raise CdxError("cdx_name 不能为空。")
    if len(name) > MAX_NAME_LEN:
        raise CdxError(f"cdx_name 最长 {MAX_NAME_LEN} 个字符。")
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in name):
        raise CdxError("cdx_name 不能包含控制字符。")
    return name


def validate_root_name(raw: str) -> str:
    name = raw.strip()
    if not name:
        raise CdxError("root 名不能为空。")
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in name):
        raise CdxError("root 名不能包含控制字符。")
    return name


def normalize_path(raw: str) -> Path:
    return Path(raw).expanduser().resolve(strict=False)


def validate_child_path(raw: str) -> Path | None:
    text = raw.strip()
    if not text:
        return None
    candidate = Path(text)
    if candidate.is_absolute():
        raise CdxError("新建文件夹名不能是绝对路径。")
    if ".." in candidate.parts:
        raise CdxError("新建文件夹名不能包含 '..'。")
    if any(part == "" for part in candidate.parts):
        raise CdxError("新建文件夹名不合法。")
    return candidate


def unique_session_id(registry: dict[str, Any]) -> str:
    existing = {s["id"] for s in registry.get("sessions", [])}
    for _ in range(20):
        sid = secrets.token_hex(4)
        if sid not in existing and not tmux_exists(f"cdx_{sid}"):
            return sid
    raise CdxError("无法生成唯一内部 id。")


def find_session_by_name(registry: dict[str, Any], name: str) -> dict[str, Any] | None:
    for session in registry.get("sessions", []):
        if session.get("name") == name:
            return session
    return None


def find_session_by_id(registry: dict[str, Any], session_id: str) -> dict[str, Any] | None:
    for session in registry.get("sessions", []):
        if session.get("id") == session_id:
            return session
    return None


def find_session_by_codex_id(registry: dict[str, Any], codex_id: str) -> dict[str, Any] | None:
    for session in registry.get("sessions", []):
        if session.get("codex_session_id") == codex_id:
            return session
    return None


def tmux_exists(name: str) -> bool:
    if shutil.which("tmux") is None:
        return False
    result = subprocess.run(["tmux", "has-session", "-t", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0


def tmux_status(session: dict[str, Any]) -> str:
    return "live" if tmux_exists(session["tmux_session"]) else "exited"


def sorted_sessions(registry: dict[str, Any]) -> list[dict[str, Any]]:
    return sorted(
        registry.get("sessions", []),
        key=lambda s: (sort_key_time(s.get("last_used_at")) or sort_key_time(s.get("created_at")), s.get("name", "")),
        reverse=True,
    )


def short_text(text: str | None, max_len: int = 28) -> str:
    if not text:
        return ""
    return text if len(text) <= max_len else text[: max_len - 1] + "…"


def print_sessions(registry: dict[str, Any]) -> list[dict[str, Any]]:
    sessions = sorted_sessions(registry)
    if not sessions:
        print_empty("当前没有 cdx 会话。")
        return []
    print_header("cdx 会话", "按最近使用时间排序；live 表示 tmux 现场仍在运行。")
    for i, session in enumerate(sessions, start=1):
        status = tmux_status(session)
        bound = "bound" if session.get("codex_session_id") else "unbound"
        used = display_time(session.get("last_used_at") or session.get("created_at"))
        name = short_text(session.get("name"), 30)
        print(f"  {cyan(str(i).rjust(2))}  {bold(name)}")
        print(f"      {status_text(status)}  {status_text(bound)}  {dim(used)}")
    return sessions


def choose_from_list(items: list[Any], prompt: str, label_fn) -> Any | None:
    if not items:
        return None
    for i, item in enumerate(items, start=1):
        print(f"[{i}] {label_fn(item)}")
    choice = globals()["prompt"](f"{prompt} [编号/名称，空取消]: ")
    if not choice:
        return None
    if choice.isdigit():
        idx = int(choice)
        if 1 <= idx <= len(items):
            return items[idx - 1]
    for item in items:
        if label_fn(item) == choice or getattr(item, "id", None) == choice:
            return item
    print(red("无效选择。"))
    return None


def choose_cdx_session(prompt: str = "选择 cdx 会话") -> dict[str, Any] | None:
    registry = load_registry()
    sessions = print_sessions(registry)
    if not sessions:
        return None
    choice = globals()["prompt"](f"{prompt} [编号/名称，空取消]: ")
    if not choice:
        return None
    if choice.isdigit():
        idx = int(choice)
        if 1 <= idx <= len(sessions):
            return sessions[idx - 1]
    for session in sessions:
        if session.get("name") == choice:
            return session
    print(red("未找到会话。"))
    return None


def ask_yes_no(prompt: str, *, default: bool = False) -> bool:
    suffix = "[Y/n]" if default else "[y/N]"
    answer = globals()["prompt"](f"{prompt} {suffix} ").lower()
    if not answer:
        return default
    return answer in {"y", "yes"}


def ensure_last_cwd(session: dict[str, Any]) -> bool:
    cwd = session.get("last_cwd")
    if cwd and Path(cwd).is_dir():
        return True
    print_header("工作目录需要确认", "恢复 Codex 前需要一个有效目录。")
    print(f"  上次目录: {yellow(cwd or '-')}")
    default = str(HOME)
    raw = prompt(f"请输入新的目录，空使用 {default}: ") or default
    path = normalize_path(raw)
    if not path.exists():
        if not ask_yes_no(f"目录不存在：{path}，是否创建？", default=False):
            return False
        try:
            path.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(red(f"创建目录失败: {exc}"))
            return False
    if not path.is_dir():
        print(red("路径存在但不是目录。"))
        return False
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session["id"])
        if not current:
            print(red("注册表中找不到该会话。"))
            return False
        current["last_cwd"] = str(path)
        current["updated_at"] = now_utc()
        save_registry(registry)
    session["last_cwd"] = str(path)
    return True


def choose_session_directory() -> str | None:
    config = load_config()
    roots = config.get("roots", [])
    if not roots:
        print_empty("没有常用目录，请先添加 root。")
        return None
    print_header("选择工作目录", "先选择常用目录；可再输入相对文件夹名，空表示直接使用该目录。")
    for i, root in enumerate(roots, start=1):
        print(f"  {cyan(str(i).rjust(2))}  {bold(root['name'])}")
        print(f"      {dim(root['path'])}")
    print(rule())
    raw = prompt("选择常用目录编号: ")
    if not raw.isdigit() or not (1 <= int(raw) <= len(roots)):
        print(red("无效选择。"))
        return None
    root_path = normalize_path(roots[int(raw) - 1]["path"])
    if not root_path.exists():
        if not ask_yes_no(f"常用目录不存在：{root_path}，是否创建？", default=False):
            return None
        try:
            root_path.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(red(f"创建常用目录失败: {exc}"))
            return None
    if not root_path.is_dir():
        print(red(f"常用目录不是目录：{root_path}"))
        return None
    child_raw = prompt("新建文件夹名（可空；支持 a/b/c）: ")
    try:
        child = validate_child_path(child_raw)
    except CdxError as exc:
        print(red(f"错误: {exc}"))
        return None
    final_path = root_path if child is None else root_path / child
    if final_path.exists() and not final_path.is_dir():
        print(red(f"路径存在但不是目录：{final_path}"))
        return None
    if not final_path.exists():
        try:
            final_path.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(red(f"创建目录失败: {exc}"))
            return None
    return str(final_path.resolve(strict=False))


def current_cdx_path() -> str:
    arg0 = Path(sys.argv[0])
    if arg0.is_absolute() and arg0.exists():
        return str(arg0.resolve())
    found = shutil.which("cdx")
    if found:
        return str(Path(found).resolve())
    return str(arg0.resolve(strict=False))


def is_hook_installed() -> bool:
    if not CODEX_HOOKS_PATH.exists():
        return False
    try:
        hooks = load_json(CODEX_HOOKS_PATH, {})
    except Exception:
        return False
    for group in hooks.get("hooks", {}).get("SessionStart", []):
        for hook in group.get("hooks", []):
            command = hook.get("command", "")
            if "__hook-session-start" in command:
                return True
    return False


def is_feature_enabled() -> bool:
    if not CODEX_CONFIG_PATH.exists():
        return False
    text = CODEX_CONFIG_PATH.read_text(encoding="utf-8")
    lines = text.splitlines()
    in_features = False
    for line in lines:
        stripped = line.strip()
        if re.match(r"^\[[^\]]+\]$", stripped):
            in_features = stripped == "[features]"
            continue
        if in_features and re.match(r"^codex_hooks\s*=\s*true\s*(#.*)?$", stripped):
            return True
    return False


def enable_codex_hooks_feature() -> None:
    CODEX_HOME.mkdir(parents=True, exist_ok=True)
    old_text = CODEX_CONFIG_PATH.read_text(encoding="utf-8") if CODEX_CONFIG_PATH.exists() else ""
    lines = old_text.splitlines()
    new_lines: list[str] = []
    in_features = False
    features_seen = False
    key_seen = False
    inserted = False

    for line in lines:
        stripped = line.strip()
        is_table = bool(re.match(r"^\[[^\]]+\]$", stripped))
        if is_table:
            if in_features and not key_seen:
                new_lines.append("codex_hooks = true")
                inserted = True
            in_features = stripped == "[features]"
            features_seen = features_seen or in_features
            key_seen = False if in_features else key_seen
            new_lines.append(line)
            continue
        if in_features and re.match(r"^codex_hooks\s*=", stripped):
            new_lines.append("codex_hooks = true")
            key_seen = True
            inserted = True
        else:
            new_lines.append(line)

    if in_features and not key_seen:
        new_lines.append("codex_hooks = true")
        inserted = True
    if not features_seen:
        if new_lines and new_lines[-1].strip():
            new_lines.append("")
        new_lines.append("[features]")
        new_lines.append("codex_hooks = true")
        inserted = True
    new_text = "\n".join(new_lines).rstrip() + "\n"
    if new_text != old_text:
        if CODEX_CONFIG_PATH.exists():
            shutil.copy2(CODEX_CONFIG_PATH, CODEX_CONFIG_PATH.with_suffix(f".toml.cdx.bak.{backup_suffix()}"))
        CODEX_CONFIG_PATH.write_text(new_text, encoding="utf-8")
        log_event("enabled codex_hooks feature")
    elif inserted:
        log_event("codex_hooks feature already enabled")


def install_hooks_json() -> None:
    CODEX_HOME.mkdir(parents=True, exist_ok=True)
    hooks = load_json(CODEX_HOOKS_PATH, {"hooks": {}})
    if not isinstance(hooks.get("hooks"), dict):
        raise CdxError(f"{CODEX_HOOKS_PATH} 格式不兼容：hooks 必须是对象。")
    events = hooks.setdefault("hooks", {})
    groups = events.setdefault("SessionStart", [])
    if not isinstance(groups, list):
        raise CdxError(f"{CODEX_HOOKS_PATH} 格式不兼容：SessionStart 必须是数组。")

    cleaned = []
    for group in groups:
        group_hooks = group.get("hooks", []) if isinstance(group, dict) else []
        kept_hooks = [h for h in group_hooks if "__hook-session-start" not in h.get("command", "")]
        if kept_hooks:
            next_group = dict(group)
            next_group["hooks"] = kept_hooks
            cleaned.append(next_group)
    command = f"{shlex.quote(current_cdx_path())} __hook-session-start"
    cleaned.append(
        {
            "matcher": "^(startup|resume)$",
            "hooks": [
                {
                    "type": "command",
                    "command": command,
                    "timeout": 10,
                    "statusMessage": CDX_HOOK_STATUS,
                }
            ],
        }
    )
    events["SessionStart"] = cleaned
    write_json_atomic(CODEX_HOOKS_PATH, hooks, backup=CODEX_HOOKS_PATH.exists(), timestamped=True)
    log_event(f"installed session-start hook: {command}")


def install_hook_interactive(auto: bool = False) -> bool:
    if auto:
        print("cdx 需要安装 Codex SessionStart hook 到 ~/.codex/hooks.json，并启用 ~/.codex/config.toml 里的 codex_hooks。")
    if not ask_yes_no("继续安装/校验 hook？", default=True):
        print("已取消 hook 安装。")
        return False
    enable_codex_hooks_feature()
    install_hooks_json()
    print("hook 已安装。")
    return True


def cmd_init(auto: bool = False) -> int:
    ensure_dirs()
    if not CONFIG_PATH.exists():
        save_config(default_config())
        print(f"已创建配置: {CONFIG_PATH}")
    if not REGISTRY_PATH.exists():
        save_registry(default_registry())
        print(f"已创建注册表: {REGISTRY_PATH}")
    if not is_feature_enabled() or not is_hook_installed():
        if not install_hook_interactive(auto=auto):
            return 1
    else:
        print("hook 已安装。")
    log_event("init completed")
    return 0


def ensure_initialized() -> bool:
    if CONFIG_PATH.exists() and REGISTRY_PATH.exists() and is_feature_enabled() and is_hook_installed():
        return True
    print("cdx 尚未初始化或 hook 缺失，先运行 init。")
    return cmd_init(auto=True) == 0


def create_record(name: str, cwd: str, codex_session_id: str | None = None, transcript_path: str | None = None) -> dict[str, Any]:
    with registry_lock():
        registry = load_registry()
        if find_session_by_name(registry, name):
            raise CdxError(f"会话已存在: {name}")
        sid = unique_session_id(registry)
        created = now_utc()
        session = {
            "id": sid,
            "name": name,
            "tmux_session": f"cdx_{sid}",
            "codex_session_id": codex_session_id,
            "last_cwd": cwd,
            "created_at": created,
            "updated_at": created,
            "last_used_at": created,
            "transcript_path": transcript_path,
        }
        registry["sessions"].append(session)
        save_registry(registry)
        log_event(f"created cdx session id={sid} name={name!r}")
        return session


def create_tmux_if_needed(session: dict[str, Any]) -> bool:
    require_tool("tmux")
    require_tool("codex")
    tmux_name = session["tmux_session"]
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session["id"])
        if not current:
            raise CdxError("注册表中找不到该会话。")
        if tmux_exists(tmux_name):
            return True
        window_name = short_text(current["name"], 30) or "cdx"
        command = f"{shlex.quote(current_cdx_path())} __runner {shlex.quote(current['id'])}"
        result = subprocess.run(
            ["tmux", "new-session", "-d", "-s", tmux_name, "-n", window_name, command],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode != 0:
            print(f"创建 tmux 失败: {result.stderr.strip() or result.stdout.strip()}")
            return False
        subprocess.run(["tmux", "set-option", "-t", tmux_name, "remain-on-exit", "off"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        log_event(f"created tmux session {tmux_name} for cdx id={current['id']}")
        return True


def attach_tmux(session: dict[str, Any]) -> int:
    tmux_name = session["tmux_session"]
    if os.environ.get("TMUX"):
        result = subprocess.run(["tmux", "switch-client", "-t", tmux_name])
    else:
        result = subprocess.run(["tmux", "attach-session", "-t", tmux_name])
    if result.returncode != 0:
        print(f"进入 tmux 失败，session 已保留: {tmux_name}")
    return result.returncode


def touch_last_used(session_id: str) -> None:
    with registry_lock():
        registry = load_registry()
        session = find_session_by_id(registry, session_id)
        if not session:
            return
        ts = now_utc()
        session["last_used_at"] = ts
        session["updated_at"] = ts
        save_registry(registry)


def enter_session(session: dict[str, Any], *, unbound_mode: str = "prompt") -> int:
    if tmux_exists(session["tmux_session"]):
        touch_last_used(session["id"])
        return attach_tmux(session)
    if not session.get("codex_session_id"):
        if unbound_mode == "new":
            pass
        else:
            print_menu(
                f"未绑定: {session['name']}",
                [
                    ("1", "新建 Codex 会话并绑定", "启动新的 Codex TUI，hook 会回写 session id"),
                    ("2", "绑定已有 Codex 会话", "从 Codex 原始历史里选择一个会话"),
                    ("3", "取消", "返回上一级"),
                ],
                "该 cdx 会话还没有绑定 Codex 原始会话。",
            )
            choice = prompt("请选择: ")
            if choice == "2":
                if map_bind(target_session_id=session["id"]) == 0:
                    with registry_lock():
                        registry = load_registry()
                        refreshed = find_session_by_id(registry, session["id"])
                        if refreshed:
                            session = refreshed
                    if not session.get("codex_session_id"):
                        return 1
                else:
                    return 1
            elif choice != "1":
                print(dim("已取消。"))
                return 1
    if not ensure_last_cwd(session):
        return 1
    touch_last_used(session["id"])
    if not create_tmux_if_needed(session):
        return 1
    return attach_tmux(session)


