def cmd_doctor(_: list[str]) -> int:
    problems = 0
    print_header(f"{APP_NAME} doctor", "只报告问题，不自动修改状态。")
    for label, path in (("配置", CONFIG_PATH), ("注册表", REGISTRY_PATH)):
        if path.exists():
            try:
                load_json(path, {})
                print(f"{green('OK ')} {label}: {dim(str(path))}")
            except Exception as exc:
                print(f"{red('ERR')} {label} JSON 无效: {exc}")
                problems += 1
        else:
            print(f"{red('ERR')} {label} 不存在: {path}")
            problems += 1

    if is_feature_enabled():
        print(f"{green('OK ')} codex_hooks feature 已启用")
    else:
        print(f"{red('ERR')} codex_hooks feature 未启用")
        problems += 1
    if is_hook_installed():
        print(f"{green('OK ')} SessionStart hook 已安装")
    else:
        print(f"{red('ERR')} SessionStart hook 未安装")
        problems += 1

    try:
        config = load_config()
        root_names = [r.get("name") for r in config.get("roots", [])]
        root_paths = [str(normalize_path(r.get("path", ""))) for r in config.get("roots", [])]
        if len(root_names) != len(set(root_names)):
            print(f"{red('ERR')} root 名重复")
            problems += 1
        if len(root_paths) != len(set(root_paths)):
            print(f"{red('ERR')} root 路径重复")
            problems += 1
        for root in config.get("roots", []):
            if Path(root.get("path", "")).expanduser().is_dir():
                print(f"{green('OK ')} root: {bold(root.get('name'))} {dim(root.get('path'))}")
            else:
                print(f"{yellow('WARN')} root 不存在或不是目录: {root.get('name')} {root.get('path')}")
    except Exception as exc:
        print(f"{red('ERR')} 读取配置失败: {exc}")
        problems += 1

    raw_ids = {s.id for s in load_codex_sessions()}
    try:
        registry = load_registry()
        names = [s.get("name") for s in registry.get("sessions", [])]
        codex_ids = [s.get("codex_session_id") for s in registry.get("sessions", []) if s.get("codex_session_id")]
        if len(names) != len(set(names)):
            print(f"{red('ERR')} cdx_name 重复")
            problems += 1
        if len(codex_ids) != len(set(codex_ids)):
            print(f"{red('ERR')} codex_session_id 重复绑定")
            problems += 1
        for session in sorted_sessions(registry):
            prefix = f"{session.get('name')} ({session.get('id')})"
            status = tmux_status(session)
            bound = session.get("codex_session_id")
            binding = "yes" if bound else "no"
            print(f"{green('OK ')} session {bold(prefix)}: tmux={status_text(status)} binding={status_text('bound') if bound else dim(binding)}")
            if bound and bound not in raw_ids:
                print(f"{yellow('WARN')} {prefix}: Codex 原始会话不在本地索引/rollout 中: {bound}")
            cwd = session.get("last_cwd")
            if cwd and not Path(cwd).is_dir():
                print(f"{yellow('WARN')} {prefix}: last_cwd 不存在: {cwd}")
    except Exception as exc:
        print(f"{red('ERR')} 读取注册表失败: {exc}")
        problems += 1

    if problems:
        print(rule())
        print(red(f"doctor 完成，发现 {problems} 个错误。"))
        return 1
    print(rule())
    print(green("doctor 完成，没有发现阻塞性错误。"))
    return 0


def cmd_runner(args: list[str]) -> int:
    if not args:
        print("missing cdx id", file=sys.stderr)
        return 2
    session_id = args[0]
    try:
        registry = load_registry()
        session = find_session_by_id(registry, session_id)
        if not session:
            print(f"cdx runner: 注册表中找不到会话 {session_id}")
            input("按 Enter 退出...")
            return 1
        cwd = session.get("last_cwd") or str(HOME)
        if not Path(cwd).is_dir():
            print(f"cdx runner: 工作目录不存在: {cwd}")
            print("请退出后运行 cdx doctor 或 cdx enter 修复。")
            input("按 Enter 退出...")
            return 1
        os.chdir(cwd)
        env = os.environ.copy()
        env["CDX_SESSION_ID"] = session["id"]
        env["CDX_NAME"] = session["name"]
        env["CDX_REGISTRY"] = str(REGISTRY_PATH)
        args = ["codex"]
        if session.get("codex_session_id"):
            args = ["codex", "resume", session["codex_session_id"]]
        log_event(f"runner starting {' '.join(args)} for cdx id={session['id']}")
        result = subprocess.run(args, env=env)
        if result.returncode != 0:
            log_event(f"runner codex exited rc={result.returncode} cdx id={session['id']}")
            print(f"\nCodex 退出码：{result.returncode}")
            print("如果是 resume 失败，请运行 cdx map 或 cdx doctor 修复映射。")
            try:
                input("按 Enter 退出 tmux...")
            except EOFError:
                pass
        return result.returncode
    except KeyboardInterrupt:
        return 130


def cmd_hook_session_start(_: list[str]) -> int:
    cdx_id = os.environ.get("CDX_SESSION_ID")
    if not cdx_id:
        return 0
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        log_event(f"hook invalid json cdx_id={cdx_id}: {exc}")
        return 0
    codex_id = payload.get("session_id") or payload.get("thread_id") or payload.get("id")
    if not codex_id:
        log_event(f"hook missing session_id cdx_id={cdx_id}")
        return 0
    cwd = payload.get("cwd")
    transcript_path = payload.get("transcript_path")
    source = payload.get("source")
    with registry_lock():
        registry = load_registry()
        session = find_session_by_id(registry, cdx_id)
        if not session:
            log_event(f"hook cdx session not found cdx_id={cdx_id} codex_id={codex_id}")
            return 0
        existing = session.get("codex_session_id")
        if existing and existing != codex_id:
            log_event(f"hook conflict cdx_id={cdx_id} existing={existing} incoming={codex_id} source={source}")
            return 0
        ts = now_utc()
        session["codex_session_id"] = codex_id
        if cwd:
            session["last_cwd"] = cwd
        if transcript_path:
            session["transcript_path"] = transcript_path
        session["last_used_at"] = ts
        session["updated_at"] = ts
        save_registry(registry)
    log_event(f"hook mapped cdx_id={cdx_id} codex_id={codex_id} source={source}")
    return 0


