def usage() -> str:
    return """用法:
  cdx                       打开菜单
  cdx list                  列出 cdx 会话
  cdx list --json           输出机器可读会话列表
  cdx new [cdx_name]        新建会话；同名则进入
  cdx new --cwd PATH --no-enter --json [cdx_name]
  cdx enter [cdx_name]      进入会话
  cdx enter --new-if-unbound [cdx_name]
  cdx enter --print-command [cdx_name]
  cdx mark-viewed --json [cdx_name]
  cdx uuid [cdx_name]       查看绑定的 Codex session id
  cdx uuid --all            列出所有 cdx 会话的绑定 UUID
  cdx delete [--yes] [cdx_name]
  cdx rename [--json] OLD NEW
  cdx roots                 管理常用目录
  cdx map                   手动映射/导入 Codex 原始会话
  cdx doctor                只报告状态问题
  cdx init                  初始化并安装 hook
  cdx install-hook          安装/刷新 Codex hook
"""


def dispatch(argv: list[str]) -> int:
    if not argv:
        if not ensure_initialized():
            return 1
        return main_menu()
    cmd, rest = argv[0], argv[1:]
    if cmd in {"-h", "--help", "help"}:
        print(usage())
        return 0
    if cmd == "__runner":
        return cmd_runner(rest)
    if cmd == "__hook-session-start":
        return cmd_hook_session_start(rest)
    if cmd == "init":
        return cmd_init()
    if cmd == "install-hook":
        return 0 if install_hook_interactive(auto=False) else 1
    if cmd == "doctor":
        return cmd_doctor(rest)
    if not ensure_initialized():
        return 1
    commands = {
        "list": cmd_list,
        "ls": cmd_list,
        "new": cmd_new,
        "add": cmd_new,
        "create": cmd_new,
        "enter": cmd_enter,
        "open": cmd_enter,
        "mark-viewed": cmd_mark_viewed,
        "viewed": cmd_mark_viewed,
        "read": cmd_mark_viewed,
        "uuid": cmd_uuid,
        "id": cmd_uuid,
        "codex-id": cmd_uuid,
        "delete": cmd_delete,
        "del": cmd_delete,
        "rm": cmd_delete,
        "rename": cmd_rename,
        "ren": cmd_rename,
        "mv": cmd_rename,
        "roots": cmd_roots,
        "root": cmd_roots,
        "map": cmd_map,
        "import": lambda a: map_import(),
    }
    handler = commands.get(cmd)
    if not handler:
        print(f"未知命令: {cmd}")
        print(usage())
        return 1
    return handler(rest)


def main() -> int:
    try:
        return dispatch(sys.argv[1:])
    except CdxError as exc:
        print(f"错误: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print()
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
