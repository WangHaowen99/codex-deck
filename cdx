        if 1 <= idx <= len(raws):
            return raws[idx - 1]
    for raw in raws:
        if raw.id == choice or raw.id.startswith(choice):
            return raw
    print(red("未找到 Codex 会话。"))
    return None


def raw_conversation_preview(raw: RawCodexSession, *, limit: int = 2) -> list[str]:
    user_snippets: list[str] = []
    assistant_snippets: list[str] = []
    seen: set[str] = set()
    if raw.transcript_path and Path(raw.transcript_path).exists():
        try:
            with Path(raw.transcript_path).open("r", encoding="utf-8") as f:
                for idx, line in enumerate(f):
                    if idx > 800 and (user_snippets or assistant_snippets):
                        break
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    payload = item.get("payload", {})
                    text = ""
                    role = ""
                    if item.get("type") == "event_msg" and payload.get("type") in {"user_message", "agent_message"}:
                        text = user_visible_conversation_text(payload.get("message"))
                        role = "user" if payload.get("type") == "user_message" else "assistant"
                    elif item.get("type") == "response_item" and payload.get("type") == "message" and payload.get("role") in {"user", "assistant"}:
                        text = user_visible_conversation_text(extract_message_content_text(payload.get("content")))
                        role = payload.get("role", "")
                    if text and text not in seen:
                        if role == "user":
                            user_snippets.append(text)
                        elif role == "assistant":
                            assistant_snippets.append(text)
                        seen.add(text)
                    if user_snippets and assistant_snippets:
                        break
        except OSError:
            pass
    if user_snippets:
        snippets = [user_snippets[0]]
        if assistant_snippets:
            snippets.append(assistant_snippets[0])
        elif len(user_snippets) > 1:
            snippets.append(user_snippets[1])
        return snippets[:limit]
    if assistant_snippets:
        return assistant_snippets[:limit]
    fallback = user_visible_conversation_text(raw.title)
    return [fallback] if fallback else ["(无可预览内容)"]


