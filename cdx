def cmd_delete(args: list[str]) -> int:
    session = resolve_session_arg(args, "删除哪个会话")
    if not session:
        return 1
    live = tmux_exists(session["tmux_session"])
    print_header("删除确认", "该操作会删除 cdx 映射，不会删除 Codex 原始历史。")
    print(f"  会话: {bold(session['name'])}")
    print(f"  tmux: {status_text('live') if live else dim('exited')}")
    print()
    print("  将执行:")
    print("  - 从 cdx 列表移除")
    if live:
        print("  - tmux 正在运行，会被直接关闭并中断 Codex")
    else:
        print("  - tmux 未运行")
    print("  - 不会删除 Codex 原始会话历史")
    confirm = prompt("输入完整会话名确认: ")
    if confirm != session["name"]:
        print(yellow("确认不匹配，已取消。"))
        return 1
    if live:
        subprocess.run(["tmux", "kill-session", "-t", session["tmux_session"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        log_event(f"killed tmux session {session['tmux_session']} during delete")
    with registry_lock():
        registry = load_registry()
        registry["sessions"] = [s for s in registry.get("sessions", []) if s.get("id") != session["id"]]
        save_registry(registry, timestamped_backup=True)
    log_event(f"deleted cdx session id={session['id']} name={session['name']!r}")
    print(green("已删除 cdx 映射。"))
    return 0


def cmd_rename(args: list[str]) -> int:
    if args:
        old_name = args[0]
        new_name = " ".join(args[1:]).strip() if len(args) > 1 else prompt("新的 cdx_name: ")
        registry = load_registry()
        session = find_session_by_name(registry, old_name)
        if not session:
            print(red(f"未找到会话: {old_name}"))
            return 1
    else:
        session = choose_cdx_session("重命名哪个会话")
        if not session:
            return 1
        new_name = prompt("新的 cdx_name: ")
    try:
        new_name = validate_name(new_name)
    except CdxError as exc:
        print(red(f"错误: {exc}"))
        return 1
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session["id"])
        if not current:
            print(red("注册表中找不到该会话。"))
            return 1
        dup = find_session_by_name(registry, new_name)
        if dup and dup.get("id") != current["id"]:
            print(red(f"会话名已存在: {new_name}"))
            return 1
        old = current["name"]
        current["name"] = new_name
        current["updated_at"] = now_utc()
        save_registry(registry, timestamped_backup=True)
    if tmux_exists(session["tmux_session"]):
        subprocess.run(
            ["tmux", "rename-window", "-t", f"{session['tmux_session']}:0", short_text(new_name, 30)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    log_event(f"renamed cdx session id={session['id']} {old!r}->{new_name!r}")
    print(green(f"已重命名: {old} -> {new_name}"))
    return 0


def cmd_roots(args: list[str]) -> int:
    sub = args[0] if args else ""
