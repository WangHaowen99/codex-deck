    log_event("init completed")
    return 0


def ensure_initialized() -> bool:
    if CONFIG_PATH.exists() and REGISTRY_PATH.exists() and is_feature_enabled() and is_hook_installed():
        return True
    print("cdx 尚未初始化或 hook 缺失，先运行 init。")
    return cmd_init(auto=True) == 0


def create_record(name: str, cwd: str, codex_session_id: str | None = None, transcript_path: str | None = None) -> dict[str, Any]:
    with registry_lock():
        registry = load_registry()
        if find_session_by_name(registry, name):
            raise CdxError(f"会话已存在: {name}")
        sid = unique_session_id(registry)
        created = now_utc()
        session = {
            "id": sid,
            "name": name,
            "tmux_session": f"cdx_{sid}",
            "codex_session_id": codex_session_id,
            "last_cwd": cwd,
            "created_at": created,
            "updated_at": created,
            "last_used_at": created,
            "last_viewed_at": later_time(created, path_mtime_iso(transcript_path)),
            "transcript_path": transcript_path,
        }
        registry["sessions"].append(session)
        save_registry(registry)
        log_event(f"created cdx session id={sid} name={name!r}")
        return session


def create_tmux_if_needed(session: dict[str, Any]) -> bool:
    require_tool("tmux")
    require_tool("codex")
    tmux_name = session["tmux_session"]
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session["id"])
        if not current:
            raise CdxError("注册表中找不到该会话。")
        if tmux_exists(tmux_name):
            configure_tmux_session(tmux_name)
            return True
        window_name = short_text(current["name"], 30) or "cdx"
        result = subprocess.run(
            ["tmux", "new-session", "-d", "-s", tmux_name, "-n", window_name],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode != 0:
            print(f"创建 tmux 失败: {result.stderr.strip() or result.stdout.strip()}")
            return False
        configure_tmux_session(tmux_name)
        command = f"exec {shlex.quote(current_cdx_path())} __runner {shlex.quote(current['id'])}"
        result = subprocess.run(
            ["tmux", "send-keys", "-t", tmux_name, command, "C-m"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if result.returncode != 0:
            print(f"启动 Codex 失败: {result.stderr.strip() or result.stdout.strip()}")
            return False
        log_event(f"created tmux session {tmux_name} for cdx id={current['id']}")
        return True


def tmux_has_latest_context_preview(session: dict[str, Any]) -> bool:
    marker = session_context_preview_marker(session)
    if not marker:
        return True
    text = tmux_capture_text(session["tmux_session"], start="-")
    if text is None:
        return True
    if marker in text:
        return True
    compact_marker = re.sub(r"\s+", "", marker)
    compact_text = re.sub(r"\s+", "", text)
    return compact_marker in compact_text


def recreate_tmux_session(session: dict[str, Any]) -> bool:
    tmux_name = session["tmux_session"]
    result = subprocess.run(
        ["tmux", "kill-session", "-t", tmux_name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0 and tmux_exists(tmux_name):
        print(f"重建 tmux 失败: {result.stderr.strip()}")
        return False
    log_event(f"recreating tmux session {tmux_name} for cdx id={session['id']}")
    return create_tmux_if_needed(session)


def ensure_tmux_ready_for_attach(session: dict[str, Any]) -> bool:
    expected_codex_id = session.get("codex_session_id")
    if not expected_codex_id:
        return True
    activity = session_activity(session)
    if activity["state"] == "running":
        return True
    tmux_name = session["tmux_session"]
    actual_codex_id = live_tmux_codex_session_id(tmux_name)
    if actual_codex_id and actual_codex_id != expected_codex_id:
        if codex_session_is_running(actual_codex_id):
            log_event(
                f"kept stale tmux session {tmux_name}; actual codex {actual_codex_id} is still running, expected {expected_codex_id}"
            )
            return True
        print(dim("检测到 tmux 现场仍是旧 Codex 会话，正在按当前 cdx 绑定重建。"))
        log_event(f"stale tmux session {tmux_name}: actual={actual_codex_id} expected={expected_codex_id}")
        return recreate_tmux_session(session)
    return True


def attach_tmux(session: dict[str, Any]) -> int:
    tmux_name = session["tmux_session"]
    configure_tmux_session(tmux_name)
    if os.environ.get("TMUX"):
        result = subprocess.run(["tmux", "switch-client", "-t", tmux_name])
    else:
        result = subprocess.run(["tmux", "attach-session", "-t", tmux_name])
    if result.returncode != 0:
        print(f"进入 tmux 失败，session 已保留: {tmux_name}")
    return result.returncode


def touch_last_used(session_id: str, *, mark_viewed: bool = False) -> None:
    with registry_lock():
        registry = load_registry()
        session = find_session_by_id(registry, session_id)
        if not session:
            return
        ts = now_utc()
        session["last_used_at"] = ts
        session["updated_at"] = ts
        if mark_viewed:
            session["last_viewed_at"] = later_time(ts, session_conversation_updated_at(session))
        save_registry(registry)


def bind_cdx_session_to_codex_id(session_id: str, codex_id: str, *, source: str) -> bool:
    transcript_path = find_codex_transcript_path(codex_id)
    if transcript_is_subagent(transcript_path):
        log_event(f"{source} ignored subagent cdx_id={session_id} codex_id={codex_id}")
        return True
    with registry_lock():
        registry = load_registry()
        session = find_session_by_id(registry, session_id)
        if not session:
            log_event(f"{source} cdx session not found cdx_id={session_id} codex_id={codex_id}")
            return False
        existing = session.get("codex_session_id")
        changed = existing != codex_id
        if changed or (transcript_path and session.get("transcript_path") != transcript_path):
            session["transcript_path"] = transcript_path
            changed = True
        if not changed:
            return True
        ts = now_utc()
        session["codex_session_id"] = codex_id
        session["last_used_at"] = ts
        session["last_viewed_at"] = later_time(ts, session_conversation_updated_at(session))
        session["updated_at"] = ts
        save_registry(registry)
    action = "remapped" if existing else "mapped"
    log_event(f"{source} {action} cdx_id={session_id} codex_id={codex_id}")
    return True


def find_recent_shell_snapshot_binding(session_id: str, *, started_at: float) -> tuple[str, Path] | None:
    if not CODEX_SHELL_SNAPSHOTS_DIR.exists():
        return None
    candidates: list[tuple[float, str, Path]] = []
    try:
        paths = list(CODEX_SHELL_SNAPSHOTS_DIR.glob("*.sh"))
    except OSError:
        return None
    for path in paths:
        try:
            stat = path.stat()
        except OSError:
            continue
        if stat.st_mtime + 2 < started_at:
            continue
        codex_id = codex_id_from_shell_snapshot_path(path)
        if not codex_id:
            continue
        env = parse_shell_snapshot_env(path)
        if env.get("CDX_SESSION_ID") != session_id:
            continue
        candidates.append((stat.st_mtime, codex_id, path))
    if not candidates:
        return None
    candidates.sort(reverse=True)
    _, codex_id, path = candidates[0]
    return codex_id, path


def bind_from_recent_shell_snapshots(session_id: str, *, started_at: float, timeout_seconds: float = 0) -> bool:
    deadline = time.time() + max(0, timeout_seconds)
    while True:
        found = find_recent_shell_snapshot_binding(session_id, started_at=started_at)
        if found:
            codex_id, path = found
            return bind_cdx_session_to_codex_id(session_id, codex_id, source=f"shell snapshot {path.name}")
        if time.time() >= deadline:
            return False
        time.sleep(0.5)


def start_shell_snapshot_binding_watcher(session_id: str, *, started_at: float) -> threading.Thread:
    watcher = threading.Thread(
        target=bind_from_recent_shell_snapshots,
        kwargs={"session_id": session_id, "started_at": started_at, "timeout_seconds": 60},
        name=f"cdx-bind-{session_id}",
        daemon=True,
    )
    watcher.start()
    return watcher


def mark_session_viewed(session_id: str) -> dict[str, Any] | None:
    with registry_lock():
        registry = load_registry()
        session = find_session_by_id(registry, session_id)
        if not session:
            return None
        ts = now_utc()
        session["last_used_at"] = ts
        session["last_viewed_at"] = later_time(ts, session_conversation_updated_at(session))
        session["updated_at"] = ts
        save_registry(registry)
        return dict(session)


def enter_session(session: dict[str, Any], *, unbound_mode: str = "prompt") -> int:
    if tmux_exists(session["tmux_session"]):
        if not ensure_tmux_ready_for_attach(session):
            return 1
        touch_last_used(session["id"], mark_viewed=True)
        return attach_tmux(session)
    if not session.get("codex_session_id"):
        if unbound_mode == "new":
            pass
        else:
            print_menu(
                f"未绑定: {session['name']}",
                [
                    ("1", "新建 Codex 会话并绑定", "启动新的 Codex TUI，hook 会回写 session id"),
                    ("2", "绑定已有 Codex 会话", "从 Codex 原始历史里选择一个会话"),
                    ("3", "取消", "返回上一级"),
                ],
                "该 cdx 会话还没有绑定 Codex 原始会话。",
            )
            choice = prompt("请选择: ")
            if choice == "2":
                if map_bind(target_session_id=session["id"]) == 0:
                    with registry_lock():
                        registry = load_registry()
                        refreshed = find_session_by_id(registry, session["id"])
                        if refreshed:
                            session = refreshed
                    if not session.get("codex_session_id"):
                        return 1
                else:
                    return 1
            elif choice != "1":
                print(dim("已取消。"))
                return 1
    if not ensure_last_cwd(session):
        return 1
    touch_last_used(session["id"], mark_viewed=True)
    if not create_tmux_if_needed(session):
        return 1
    return attach_tmux(session)


