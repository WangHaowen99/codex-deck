def print_error(message: str, *, json_mode: bool = False) -> None:
    if json_mode:
        emit_json({"ok": False, "error": message})
    else:
        print(red(message))


def take_flag(args: list[str], flag: str) -> bool:
    found = False
    kept = []
    for arg in args:
        if arg == flag:
            found = True
        else:
            kept.append(arg)
    args[:] = kept
    return found


def take_option(args: list[str], option: str) -> str | None:
    for i, arg in enumerate(list(args)):
        if arg == option:
            if i + 1 >= len(args):
                raise CdxError(f"{option} 需要参数。")
            value = args[i + 1]
            del args[i : i + 2]
            return value
        prefix = option + "="
        if arg.startswith(prefix):
            value = arg[len(prefix) :]
            del args[i]
            return value
    return None


def ensure_cwd_path(raw: str) -> str:
    path = normalize_path(raw)
    if not path.exists():
        path.mkdir(parents=True, exist_ok=True)
    if not path.is_dir():
        raise CdxError(f"工作目录不是目录: {path}")
    return str(path)


def choose_from_list(items: list[Any], prompt: str, label_fn) -> Any | None:
    if not items:
        return None
    for i, item in enumerate(items, start=1):
        print(f"[{i}] {label_fn(item)}")
    choice = globals()["prompt"](f"{prompt} [编号/名称，空取消]: ")
    if not choice:
        return None
    if choice.isdigit():
        idx = int(choice)
        if 1 <= idx <= len(items):
            return items[idx - 1]
    for item in items:
        if label_fn(item) == choice or getattr(item, "id", None) == choice:
            return item
    print(red("无效选择。"))
    return None


def choose_cdx_session(prompt: str = "选择 cdx 会话") -> dict[str, Any] | None:
    registry = load_registry()
    sessions = print_sessions(registry)
    if not sessions:
        return None
    choice = globals()["prompt"](f"{prompt} [编号/名称，空取消]: ")
    if not choice:
        return None
    if choice.isdigit():
        idx = int(choice)
        if 1 <= idx <= len(sessions):
            return sessions[idx - 1]
    for session in sessions:
        if session.get("name") == choice:
            return session
    print(red("未找到会话。"))
    return None


def ask_yes_no(prompt: str, *, default: bool = False) -> bool:
    suffix = "[Y/n]" if default else "[y/N]"
    answer = globals()["prompt"](f"{prompt} {suffix} ").lower()
    if not answer:
        return default
    return answer in {"y", "yes"}


def ensure_last_cwd(session: dict[str, Any]) -> bool:
    cwd = session.get("last_cwd")
    if cwd and Path(cwd).is_dir():
        return True
    print_header("工作目录需要确认", "恢复 Codex 前需要一个有效目录。")
    print(f"  上次目录: {yellow(cwd or '-')}")
    default = str(HOME)
    raw = prompt(f"请输入新的目录，空使用 {default}: ") or default
    path = normalize_path(raw)
    if not path.exists():
        if not ask_yes_no(f"目录不存在：{path}，是否创建？", default=False):
            return False
        try:
            path.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            print(red(f"创建目录失败: {exc}"))
            return False
    if not path.is_dir():
        print(red("路径存在但不是目录。"))
        return False
    with registry_lock():
        registry = load_registry()
        current = find_session_by_id(registry, session["id"])
        if not current:
            print(red("注册表中找不到该会话。"))
            return False
        current["last_cwd"] = str(path)
        current["updated_at"] = now_utc()
        save_registry(registry)
    session["last_cwd"] = str(path)
    return True


