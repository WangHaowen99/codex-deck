def tmux_exists(name: str) -> bool:
    if shutil.which("tmux") is None:
        return False
    result = subprocess.run(["tmux", "has-session", "-t", name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return result.returncode == 0


def tmux_status(session: dict[str, Any]) -> str:
    return "live" if tmux_exists(session["tmux_session"]) else "exited"


def tmux_display_value(target: str, fmt: str) -> str | None:
    result = subprocess.run(
        ["tmux", "display-message", "-p", "-t", target, fmt],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        log_event(f"tmux display failed target={target}: {result.stderr.strip()}")
        return None
    return result.stdout.strip()


def tmux_capture_text(tmux_name: str, *, start: str = "-2000") -> str | None:
    result = subprocess.run(
        ["tmux", "capture-pane", "-p", "-t", tmux_name, "-S", start, "-E", "-"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        log_event(f"tmux capture failed session={tmux_name}: {result.stderr.strip()}")
        return None
    return result.stdout


def codex_session_id_from_process_output(output: str) -> str | None:
    found: str | None = None
    for line in output.splitlines():
        if "codex" not in line or "resume" not in line:
            continue
        matches = CODEX_ID_PATTERN.findall(line)
        if matches:
            found = matches[-1]
    return found


def live_tmux_codex_session_id(tmux_name: str) -> str | None:
    pane_pid = tmux_display_value(tmux_name, "#{pane_pid}")
    if not pane_pid or not pane_pid.isdigit():
        return None
    sid_result = subprocess.run(
        ["ps", "-o", "sid=", "-p", pane_pid],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if sid_result.returncode != 0:
        log_event(f"ps sid failed pane_pid={pane_pid}: {sid_result.stderr.strip()}")
        return None
    sid = sid_result.stdout.strip()
    if not sid:
        return None
    commands_result = subprocess.run(
        ["ps", "-o", "command=", "-g", sid],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if commands_result.returncode != 0:
        log_event(f"ps process group failed sid={sid}: {commands_result.stderr.strip()}")
        return None
    return codex_session_id_from_process_output(commands_result.stdout)


def configure_tmux_session(tmux_name: str) -> None:
    if shutil.which("tmux") is None:
        return
    options = [
        ("mouse", "on"),
        ("history-limit", str(TMUX_HISTORY_LIMIT)),
        ("remain-on-exit", "off"),
        ("@cdx_scroll_mode", "accelerated-copy-mode"),
    ]
    for option, value in options:
        result = subprocess.run(
            ["tmux", "set-option", "-q", "-t", tmux_name, option, value],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            log_event(f"tmux option failed session={tmux_name} option={option} value={value}: {result.stderr.strip()}")
    install_tmux_mouse_bindings()


def configure_tmux_server() -> None:
    if shutil.which("tmux") is None:
        return
    result = subprocess.run(
        ["tmux", "set-option", "-gq", "mouse", "on"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        log_event(f"tmux global mouse option failed: {result.stderr.strip()}")


def install_tmux_mouse_bindings() -> None:
    if shutil.which("tmux") is None:
        return
    scroll_lines = str(TMUX_SCROLL_LINES)
    bindings = [
        [
            "bind-key",
            "-T",
            "root",
            "WheelUpPane",
            "if-shell",
            "-F",
            "-t",
            "=",
            "#{==:#{@cdx_scroll_mode},accelerated-copy-mode}",
            f"if-shell -F -t = '#{{pane_in_mode}}' 'send-keys -X -N {scroll_lines} scroll-up' 'copy-mode -e -t ='",
            "if-shell -F -t = '#{||:#{pane_in_mode},#{mouse_any_flag}}' 'send-keys -M' 'copy-mode -e -t ='",
        ],
        [
            "bind-key",
            "-T",
            "root",
            "WheelDownPane",
            "if-shell",
            "-F",
            "-t",
            "=",
            "#{==:#{@cdx_scroll_mode},accelerated-copy-mode}",
            f"if-shell -F -t = '#{{pane_in_mode}}' \"if-shell -F -t = '#{{pane_at_bottom}}' 'send-keys -X cancel' 'send-keys -X -N {scroll_lines} scroll-down'\" 'send-keys -M'",
            "send-keys -M",
        ],
    ]
    for binding in bindings:
        result = subprocess.run(
            ["tmux", *binding],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if result.returncode != 0:
            log_event(f"tmux mouse binding failed: {' '.join(binding)}: {result.stderr.strip()}")


def sorted_sessions(registry: dict[str, Any]) -> list[dict[str, Any]]:
    return sorted(
        registry.get("sessions", []),
        key=lambda s: (sort_key_time(s.get("last_used_at")) or sort_key_time(s.get("created_at")), s.get("name", "")),
        reverse=True,
    )


def short_text(text: str | None, max_len: int = 28) -> str:
    if not text:
        return ""
    return text if len(text) <= max_len else text[: max_len - 1] + "…"


def short_display_text(text: str | None, max_width: int) -> str:
    if not text:
        return ""
    cleaned = re.sub(r"\s+", " ", text).strip()
    if not cleaned or max_width <= 0:
        return ""
    if display_len(cleaned) <= max_width:
        return cleaned
    if max_width <= 1:
        return "…"
    limit = max_width - 1
    width = 0
    pieces: list[str] = []
    for ch in cleaned:
        ch_width = 2 if unicodedata.east_asian_width(ch) in {"F", "W"} else 1
        if width + ch_width > limit:
            break
        pieces.append(ch)
        width += ch_width
    trimmed = "".join(pieces).rstrip()
    return (trimmed + "…") if trimmed else "…"


def compact_uuid(text: str | None) -> str:
    if not text:
        return ""
    value = text.strip()
    if len(value) <= 15:
        return value
    return f"{value[:8]}...{value[-4:]}"


def path_mtime_iso(path: str | None) -> str | None:
    if not path:
        return None
    try:
        mtime = Path(path).stat().st_mtime
    except OSError:
        return None
    return datetime.fromtimestamp(mtime, timezone.utc).isoformat().replace("+00:00", "Z")


def codex_id_from_text(text: str | None) -> str | None:
    if not text:
        return None
    match = CODEX_ID_PATTERN.search(text)
    return match.group(1) if match else None


def codex_id_from_shell_snapshot_path(path: Path) -> str | None:
    return codex_id_from_text(path.name)


def parse_shell_snapshot_env(path: Path) -> dict[str, str]:
    env: dict[str, str] = {}
    try:
        with path.open("r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if not line.startswith("declare -x "):
                    continue
                try:
                    parts = shlex.split(line, posix=True)
                except ValueError:
                    continue
                for part in parts[2:]:
                    if "=" not in part:
                        continue
                    key, value = part.split("=", 1)
                    env[key] = value
    except OSError:
        return {}
    return env


def find_codex_transcript_path(codex_id: str | None) -> str | None:
    if not codex_id:
        return None
    state_db = CODEX_HOME / "state_5.sqlite"
    if state_db.exists():
        try:
            import sqlite3

            with sqlite3.connect(str(state_db)) as conn:
                row = conn.execute("select rollout_path from threads where id = ?", (codex_id,)).fetchone()
            if row and row[0] and Path(row[0]).exists():
                return str(row[0])
        except Exception:
            pass
    if not CODEX_SESSIONS_DIR.exists():
        return None
    try:
        matches = [path for path in CODEX_SESSIONS_DIR.glob(f"**/*{codex_id}*.jsonl") if path.is_file()]
    except OSError:
        return None
    if not matches:
        return None
    matches.sort(key=lambda path: path.stat().st_mtime if path.exists() else 0, reverse=True)
    return str(matches[0])


def resolve_session_transcript_path(session: dict[str, Any]) -> str | None:
    transcript_path = session.get("transcript_path")
    if transcript_path and Path(transcript_path).exists():
        return transcript_path
    resolved = find_codex_transcript_path(session.get("codex_session_id"))
    return resolved or transcript_path


def later_time(left: str | None, right: str | None) -> str | None:
    left_dt = parse_iso(left)
    right_dt = parse_iso(right)
    if left_dt and right_dt:
        return left if left_dt >= right_dt else right
    return left if left_dt else right


def session_conversation_updated_at(session: dict[str, Any]) -> str | None:
    return path_mtime_iso(resolve_session_transcript_path(session))


def transcript_task_window(path: str | None, *, max_lines: int = 1200) -> tuple[str | None, str | None]:
    if not path:
        return None, None
    transcript = Path(path)
    if not transcript.exists():
        return None, None
    try:
        lines = transcript.read_text(encoding="utf-8", errors="ignore").splitlines()[-max_lines:]
    except OSError:
        return None, None
    latest_started: str | None = None
    latest_complete: str | None = None
    for line in lines:
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        payload = item.get("payload", {})
        if item.get("type") != "event_msg" or not isinstance(payload, dict):
            continue
        event_type = payload.get("type")
        timestamp = item.get("timestamp") or payload.get("timestamp")
        if not isinstance(timestamp, str) or not parse_iso(timestamp):
            continue
        if event_type == "task_started":
            latest_started = timestamp
        elif event_type == "task_complete":
            latest_complete = timestamp
    return latest_started, latest_complete


def codex_session_is_running(codex_id: str | None) -> bool:
    if not codex_id:
        return False
    started_at, completed_at = transcript_task_window(find_codex_transcript_path(codex_id))
    started_dt = parse_iso(started_at)
    completed_dt = parse_iso(completed_at)
    return bool(started_dt and (not completed_dt or started_dt > completed_dt))


def transcript_is_subagent(path: str | None, *, max_lines: int = 50) -> bool:
    if not path:
        return False
    transcript = Path(path)
    if not transcript.exists():
        return False
    try:
        with transcript.open("r", encoding="utf-8", errors="ignore") as f:
            for idx, line in enumerate(f):
                if idx >= max_lines:
                    break
                try:
                    item = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if item.get("type") != "session_meta":
                    continue
                payload = item.get("payload", {})
                if not isinstance(payload, dict):
                    return False
                source = payload.get("source")
                return payload.get("thread_source") == "subagent" or (
                    isinstance(source, dict) and "subagent" in source
                )
    except OSError:
        return False
    return False


def session_activity(session: dict[str, Any], *, now: datetime | None = None) -> dict[str, Any]:
    if not session.get("codex_session_id"):
        return {"state": "none", "started_at": None, "elapsed_seconds": None}
    started_at, completed_at = transcript_task_window(resolve_session_transcript_path(session))
    started_dt = parse_iso(started_at)
    completed_dt = parse_iso(completed_at)
    live = tmux_exists(session["tmux_session"])
    if live and started_dt and (not completed_dt or started_dt > completed_dt):
        now_dt = now or datetime.now(timezone.utc)
        elapsed = max(0, int((now_dt - started_dt).total_seconds()))
        return {"state": "running", "started_at": started_at, "elapsed_seconds": elapsed}
    if session_has_unread_result(session):
        return {"state": "unread", "started_at": None, "elapsed_seconds": None}
    return {"state": "read", "started_at": None, "elapsed_seconds": None}


def session_viewed_at(session: dict[str, Any]) -> str | None:
    return session.get("last_viewed_at") or session.get("last_used_at") or session.get("created_at")


def session_has_unread_result(session: dict[str, Any]) -> bool:
    if not session.get("codex_session_id"):
        return False
    updated_at = session_conversation_updated_at(session)
    if not updated_at:
        return False
    viewed_at = session_viewed_at(session)
    if not viewed_at:
        return True
    updated_dt = parse_iso(updated_at)
    viewed_dt = parse_iso(viewed_at)
    if not updated_dt:
        return False
    if not viewed_dt:
        return True
    return updated_dt > viewed_dt


def view_state_text(session: dict[str, Any]) -> str:
    activity = session_activity(session)
    if activity["state"] == "running":
        return cyan("running")
    if activity["state"] == "unread":
        return red("● unread")
    if activity["state"] == "read":
        return green("● read")
    if not session.get("codex_session_id"):
        return dim("no-result")
    return dim("unknown")


def normalize_preview_text(text: str | None) -> str:
    if not text:
        return ""
    return re.sub(r"\s+", " ", text).strip()


def user_visible_conversation_text(text: str | None) -> str:
    cleaned = normalize_preview_text(text)
    if not cleaned:
        return ""
    internal_prefixes = (
        "# AGENTS.md instructions",
        "Another language model started to solve this problem",
        "<environment_context>",
        "<permissions instructions>",
        "<collaboration_mode>",
        "<skills_instructions>",
        "<INSTRUCTIONS>",
    )
    return "" if cleaned.startswith(internal_prefixes) else cleaned


def extract_message_content_text(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    pieces = []
    for item in content:
        if not isinstance(item, dict):
            continue
        if item.get("type") in {"input_text", "output_text", "text"}:
            text = item.get("text")
            if isinstance(text, str):
                pieces.append(text)
    return " ".join(pieces)


def transcript_visible_message(item: dict[str, Any]) -> tuple[str, str] | None:
    payload = item.get("payload")
    if not isinstance(payload, dict):
        return None
    text = ""
    role = ""
    if item.get("type") == "event_msg" and payload.get("type") in {"user_message", "agent_message"}:
        message = payload.get("message")
        text = message if isinstance(message, str) else ""
        role = "用户" if payload.get("type") == "user_message" else "Codex"
    elif item.get("type") == "response_item" and payload.get("type") == "message" and payload.get("role") in {"user", "assistant"}:
        text = extract_message_content_text(payload.get("content"))
        role = "用户" if payload.get("role") == "user" else "Codex"
    visible = user_visible_conversation_text(text)
    if not visible:
        return None
    return role, visible


def transcript_visible_messages(path: str | None) -> list[tuple[str, str]]:
    if not path:
        return []
    transcript = Path(path)
    if not transcript.exists():
        return []
    messages: list[tuple[str, str]] = []
    previous: tuple[str, str] | None = None
    try:
        with transcript.open("r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                try:
                    item = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(item, dict):
                    continue
                message = transcript_visible_message(item)
                if not message or message == previous:
                    continue
                messages.append(message)
                previous = message
    except OSError:
        return []
    return messages


def truncate_preview_message(text: str, max_chars: int) -> str:
    if max_chars <= 0:
        return ""
    if len(text) <= max_chars:
        return text
    if max_chars <= 3:
        return text[:max_chars]
    return text[: max_chars - 3].rstrip() + "..."


def wrap_display_line(text: str, width: int) -> list[str]:
    width = max(12, width)
    lines: list[str] = []
    current: list[str] = []
    current_width = 0
    for ch in text:
        ch_width = 2 if unicodedata.east_asian_width(ch) in {"F", "W"} else 1
        if current and current_width + ch_width > width:
            lines.append("".join(current).rstrip())
            current = []
            current_width = 0
        current.append(ch)
        current_width += ch_width
    if current:
        lines.append("".join(current).rstrip())
    return lines or [""]


def transcript_context_preview(
    path: str | None,
    *,
    max_messages: int = CONTEXT_PREVIEW_MAX_MESSAGES,
    width: int | None = None,
    max_chars_per_message: int = CONTEXT_PREVIEW_MAX_CHARS_PER_MESSAGE,
    marker: str | None = None,
) -> str:
    messages = transcript_visible_messages(path)
    if not messages or max_messages <= 0:
        return ""
    selected = messages[-max_messages:]
    preview_width = max(36, min(width or ui_width(), 104))
    body_width = max(24, preview_width - 2)
    lines: list[str] = []
    if marker:
        lines.append(marker)
    lines.append(f"[cdx] 最近 {len(selected)} 条 Codex 对话上下文")
    lines.append("[cdx] 来自本地 transcript，手机切回时可向上滚动查看。")
    lines.append("-" * body_width)
    for role, text in selected:
        normalized = normalize_preview_text(text)
        truncated = truncate_preview_message(normalized, max_chars_per_message)
        prefix = f"{role}: "
        wrapped = wrap_display_line(prefix + truncated, body_width)
        lines.extend(wrapped)
        lines.append("")
    if lines and lines[-1] == "":
        lines.pop()
    lines.append("-" * body_width)
    lines.append("[cdx] 上下文预览结束，下面进入 Codex。")
    return "\n".join(lines)


def transcript_visible_fingerprint(path: str | None) -> str | None:
    messages = transcript_visible_messages(path)
    if not messages:
        return None
    role, text = messages[-1]
    digest = hashlib.sha256(f"{len(messages)}\0{role}\0{text}".encode("utf-8")).hexdigest()[:16]
    return f"visible={len(messages)}:{digest}"


def session_context_preview_marker(session: dict[str, Any]) -> str | None:
    if not session.get("codex_session_id"):
        return None
    fingerprint = transcript_visible_fingerprint(resolve_session_transcript_path(session))
    if not fingerprint:
        return None
    return f"[cdx-context-preview id={session.get('id', '')} codex={session.get('codex_session_id', '')} {fingerprint}]"


def print_session_context_preview(session: dict[str, Any]) -> None:
    preview = transcript_context_preview(
        resolve_session_transcript_path(session),
        marker=session_context_preview_marker(session),
    )
    if preview:
        print()
        print(preview, flush=True)
        print(flush=True)


def empty_transcript_metrics() -> dict[str, int | None]:
    return {
        "total_tokens": None,
        "turn_count": None,
        "context_tokens": None,
        "context_window": None,
        "context_percent": None,
        "compaction_count": 0,
        "tool_call_count": 0,
        "cache_hit_percent": None,
        "failure_count": 0,
        "shell_command_count": 0,
        "web_search_count": 0,
        "patch_apply_count": 0,
        "subagent_count": 0,
        "edited_file_count": 0,
        "command_success_percent": None,
        "command_duration_seconds": 0,
        "last_turn_duration_seconds": None,
        "time_to_first_token_ms": None,
    }


def int_token_value(value: Any) -> int | None:
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value if value >= 0 else None
    if isinstance(value, float) and value >= 0 and value.is_integer():
        return int(value)
    return None


def usage_total_tokens(usage: Any) -> int | None:
    if not isinstance(usage, dict):
        return None
    total = int_token_value(usage.get("total_tokens"))
    if total is not None:
        return total
    parts = [
        int_token_value(usage.get("input_tokens")),
        int_token_value(usage.get("output_tokens")),
    ]
    if all(part is None for part in parts):
        return None
    return sum(part or 0 for part in parts)


def usage_input_tokens(usage: Any) -> int | None:
    if not isinstance(usage, dict):
        return None
    return int_token_value(usage.get("input_tokens"))


def usage_cached_input_tokens(usage: Any) -> int | None:
    if not isinstance(usage, dict):
        return None
    return int_token_value(usage.get("cached_input_tokens"))


def duration_seconds_value(duration: Any) -> float | None:
    if not isinstance(duration, dict):
        return None
    secs = duration.get("secs")
    nanos = duration.get("nanos")
    total = 0.0
    found = False
    if isinstance(secs, (int, float)) and not isinstance(secs, bool) and secs >= 0:
        total += float(secs)
        found = True
    if isinstance(nanos, (int, float)) and not isinstance(nanos, bool) and nanos >= 0:
        total += float(nanos) / 1_000_000_000
        found = True
    return total if found else None


def milliseconds_to_seconds(value: Any) -> int | None:
    millis = int_token_value(value)
    if millis is None:
        return None
    return round(millis / 1000)


def transcript_metrics(path: str | None) -> dict[str, int | None]:
    metrics = empty_transcript_metrics()
    if not path:
        return metrics
    transcript = Path(path)
    if not transcript.exists():
        return metrics
    turn_count = 0
    last_turn_text: str | None = None
    last_turn_time: datetime | None = None
    compaction_positions: list[tuple[float | None, int]] = []
    edited_file_paths: set[str] = set()
    command_count = 0
    command_success_count = 0
    command_duration_total = 0.0

    def add_user_turn(text: str | None, timestamp: str | None) -> None:
        nonlocal last_turn_text, last_turn_time, turn_count
        visible = user_visible_conversation_text(text)
        if not visible:
            return
        turn_time = parse_iso(timestamp) if isinstance(timestamp, str) else None
        if visible == last_turn_text:
            if turn_time is None or last_turn_time is None:
                return
            if abs((turn_time - last_turn_time).total_seconds()) <= 2:
                return
        turn_count += 1
        last_turn_text = visible
        last_turn_time = turn_time

    def add_compaction(timestamp: str | None, line_no: int) -> None:
        parsed = parse_iso(timestamp) if isinstance(timestamp, str) else None
        seconds = parsed.timestamp() if parsed else None
        for previous_seconds, previous_line in compaction_positions:
            if seconds is not None and previous_seconds is not None:
                if abs(seconds - previous_seconds) <= 1:
                    return
            elif seconds is None and previous_seconds is None and abs(line_no - previous_line) <= 2:
                return
        compaction_positions.append((seconds, line_no))
        metrics["compaction_count"] = (metrics["compaction_count"] or 0) + 1

    try:
        with transcript.open("r", encoding="utf-8", errors="ignore") as f:
            for line_no, line in enumerate(f, start=1):
                try:
                    item = json.loads(line)
                except json.JSONDecodeError:
                    continue
                payload = item.get("payload", {})
                item_type = item.get("type")
                if item_type == "compacted":
                    timestamp = item.get("timestamp")
                    add_compaction(timestamp if isinstance(timestamp, str) else None, line_no)
                if item.get("type") == "response_item" and isinstance(payload, dict):
                    payload_type = payload.get("type")
                    if payload_type in {"function_call", "custom_tool_call", "web_search_call"}:
                        metrics["tool_call_count"] = (metrics["tool_call_count"] or 0) + 1
                    if payload_type == "function_call":
                        name = payload.get("name")
                        if name == "exec_command":
                            metrics["shell_command_count"] = (metrics["shell_command_count"] or 0) + 1
                        elif name == "spawn_agent":
                            metrics["subagent_count"] = (metrics["subagent_count"] or 0) + 1
                    elif payload_type == "custom_tool_call" and payload.get("name") == "apply_patch":
                        metrics["patch_apply_count"] = (metrics["patch_apply_count"] or 0) + 1
                    elif payload_type == "web_search_call":
                        metrics["web_search_count"] = (metrics["web_search_count"] or 0) + 1
                    if payload_type == "message" and payload.get("role") == "user":
                        timestamp = item.get("timestamp") or payload.get("timestamp")
                        add_user_turn(
                            extract_message_content_text(payload.get("content")),
                            timestamp if isinstance(timestamp, str) else None,
                        )
                if item.get("type") != "event_msg" or not isinstance(payload, dict):
                    continue
                event_type = payload.get("type")
                if event_type == "user_message":
                    message = payload.get("message")
                    timestamp = item.get("timestamp") or payload.get("timestamp")
                    add_user_turn(
                        message if isinstance(message, str) else None,
                        timestamp if isinstance(timestamp, str) else None,
                    )
                elif event_type == "context_compacted":
                    timestamp = item.get("timestamp")
                    add_compaction(timestamp if isinstance(timestamp, str) else None, line_no)
                elif event_type == "exec_command_end":
                    command_count += 1
                    exit_code = payload.get("exit_code")
                    status = payload.get("status")
                    succeeded = status == "completed" and exit_code == 0
                    if succeeded:
                        command_success_count += 1
                    else:
                        metrics["failure_count"] = (metrics["failure_count"] or 0) + 1
                    duration = duration_seconds_value(payload.get("duration"))
                    if duration is not None:
                        command_duration_total += duration
                elif event_type == "patch_apply_end":
                    if payload.get("success") is False or payload.get("status") not in {None, "completed"}:
                        metrics["failure_count"] = (metrics["failure_count"] or 0) + 1
                    changes = payload.get("changes")
                    if isinstance(changes, dict):
                        edited_file_paths.update(str(path) for path in changes.keys())
                elif event_type == "error":
                    metrics["failure_count"] = (metrics["failure_count"] or 0) + 1
                elif event_type == "turn_aborted":
                    metrics["failure_count"] = (metrics["failure_count"] or 0) + 1
                    metrics["last_turn_duration_seconds"] = milliseconds_to_seconds(payload.get("duration_ms"))
                elif event_type == "task_complete":
                    metrics["last_turn_duration_seconds"] = milliseconds_to_seconds(payload.get("duration_ms"))
                    metrics["time_to_first_token_ms"] = int_token_value(payload.get("time_to_first_token_ms"))
                elif event_type == "token_count":
                    info = payload.get("info")
                    if not isinstance(info, dict):
                        continue
                    total_usage = info.get("total_token_usage")
                    total_tokens = usage_total_tokens(total_usage)
                    context_tokens = usage_total_tokens(info.get("last_token_usage"))
                    context_window = int_token_value(info.get("model_context_window"))
                    metrics["total_tokens"] = total_tokens
                    metrics["context_tokens"] = context_tokens
                    metrics["context_window"] = context_window
                    if context_tokens is not None and context_window and context_window > 0:
                        metrics["context_percent"] = round(context_tokens / context_window * 100)
                    else:
                        metrics["context_percent"] = None
                    input_tokens = usage_input_tokens(total_usage)
                    cached_tokens = usage_cached_input_tokens(total_usage)
                    if input_tokens and input_tokens > 0 and cached_tokens is not None:
                        metrics["cache_hit_percent"] = round(cached_tokens / input_tokens * 100)
                    else:
                        metrics["cache_hit_percent"] = None
    except OSError:
        return metrics
    metrics["turn_count"] = turn_count
    metrics["edited_file_count"] = len(edited_file_paths)
    metrics["command_duration_seconds"] = round(command_duration_total)
    if command_count:
        metrics["command_success_percent"] = round(command_success_count / command_count * 100)
    return metrics


def print_sessions(registry: dict[str, Any]) -> list[dict[str, Any]]:
    sessions = sorted_sessions(registry)
    if not sessions:
        print_empty("当前没有 cdx 会话。")
        return []
    print_header("cdx 会话", "按最近使用时间排序；live 表示 tmux 现场仍在运行；● unread 表示有未查看结果。")
    for i, session in enumerate(sessions, start=1):
        status = tmux_status(session)
        bound = "bound" if session.get("codex_session_id") else "unbound"
        used = display_time(session.get("last_used_at") or session.get("created_at"))
        name = short_text(session.get("name"), 30)
        print(f"  {cyan(str(i).rjust(2))}  {bold(name)}")
        print(f"      {status_text(status)}  {status_text(bound)}  {view_state_text(session)}  {dim(used)}")
    return sessions


