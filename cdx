def cmd_new(args: list[str]) -> int:
    args = list(args)
    json_mode = take_flag(args, "--json")
    no_enter = take_flag(args, "--no-enter") or json_mode
    try:
        cwd_arg = take_option(args, "--cwd")
    except CdxError as exc:
        print_error(f"错误: {exc}", json_mode=json_mode)
        return 1
    try:
        require_tool("tmux")
        require_tool("codex")
    except CdxError as exc:
        print_error(f"错误: {exc}", json_mode=json_mode)
        return 1
    if args:
        name = " ".join(args).strip()
    elif no_enter:
        print_error("缺少 cdx_name。", json_mode=json_mode)
        return 1
    else:
        name = prompt("cdx_name: ")
    try:
        name = validate_name(name)
    except CdxError as exc:
        print_error(f"错误: {exc}", json_mode=json_mode)
        return 1
    registry = load_registry()
    existing = find_session_by_name(registry, name)
    if existing:
        if json_mode:
            emit_json({"ok": True, "existing": True, "session": session_json(existing)})
            return 0
        print(cyan(f"会话“{name}”已存在，直接进入。"))
        if no_enter:
            return 0
        return enter_session(existing)
    if cwd_arg is not None:
        try:
            cwd = ensure_cwd_path(cwd_arg)
        except (CdxError, OSError) as exc:
            print_error(f"错误: {exc}", json_mode=json_mode)
            return 1
    else:
        if no_enter:
            print_error("非交互新建会话需要 --cwd。", json_mode=json_mode)
            return 1
        cwd = choose_session_directory()
        if not cwd:
            return 1
    try:
        session = create_record(name, cwd)
    except CdxError as exc:
        print_error(f"错误: {exc}", json_mode=json_mode)
        return 1
    if json_mode:
        emit_json({"ok": True, "existing": False, "session": session_json(session)})
    if no_enter:
        return 0
    return enter_session(session, unbound_mode="new")


def resolve_session_arg(args: list[str], prompt: str, *, noninteractive: bool = False, json_mode: bool = False) -> dict[str, Any] | None:
    if args:
        name = " ".join(args).strip()
        registry = load_registry()
        session = find_session_by_name(registry, name)
        if not session:
            print_error(f"未找到会话: {name}", json_mode=json_mode)
            return None
        return session
    if noninteractive:
        print_error("缺少 cdx_name。", json_mode=json_mode)
        return None
    return choose_cdx_session(prompt)


